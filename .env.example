# ============================================================================
#  Brokerage-AI — environment configuration
#  Copy to .env and fill in values:   cp .env.example .env
#
#  Legend:
#    [LOCAL]  required for the offline local demo (DEMO_MODE=true)
#    [PROD]   required only in production (ignored / stubbed in DEMO_MODE)
#    [OPT]    optional everywhere (sensible default already applied)
# ============================================================================

# ----------------------------------------------------------------------------
#  DEMO MODE  — flip this ON for laptop testing with NO external accounts.
#  In demo mode: Stripe checkout activates instantly, Gemini returns a
#  deterministic stub, files are written to ./local_storage, and SQLite is used.
# ----------------------------------------------------------------------------
DEMO_MODE=true                       # [LOCAL] set false in production

# ----------------------------------------------------------------------------
#  Database
#    Local : SQLite file (zero setup).
#    Prod  : Supabase Postgres "Connection string -> URI" (region ca-central-1).
# ----------------------------------------------------------------------------
DATABASE_URL=sqlite:///./brokerage.db                          # [LOCAL]
# DATABASE_URL=postgresql://postgres:postgres@db.xxx.supabase.co:5432/postgres  # [PROD]

# ----------------------------------------------------------------------------
#  Webhook auth + Approval JWT
#  Generate strong secrets with:
#      python -c "import secrets; print(secrets.token_urlsafe(48))"
#    (or:  openssl rand -hex 32)
# ----------------------------------------------------------------------------
WEBHOOK_SHARED_SECRET=local-dev-secret-change-me     # [LOCAL] header x-webhook-secret
JWT_SECRET=GENERATE_ME_WITH_THE_COMMAND_ABOVE        # [LOCAL] signs /approve/{token}
JWT_ALGORITHM=HS256                                  # [OPT]
APPROVAL_TOKEN_TTL_HOURS=168                          # [OPT] 7 days

# ----------------------------------------------------------------------------
#  App URLs (used by Streamlit + email links)
# ----------------------------------------------------------------------------
API_BASE_URL=http://localhost:8000                   # [LOCAL]
APP_BASE_URL=http://localhost:8501                   # [OPT]
# n8n FLOW 2: backend POSTs here after a broker approval -> n8n sends final
# client email. Leave empty to disable (approval still works).
N8N_APPROVAL_WEBHOOK_URL=                             # [PROD] e.g. https://n8n.you.ca/webhook/approval-complete

# ----------------------------------------------------------------------------
#  Billing links surfaced by the 429 (quota) and 403 (inactive) gates.
#  n8n renders these in upgrade / reactivate emails.
# ----------------------------------------------------------------------------
STRIPE_UPGRADE_URL=https://app.brokerage-ai.ca/billing/upgrade       # [OPT]
STRIPE_BILLING_PORTAL_URL=https://billing.stripe.com/p/login/portal  # [OPT]

# ----------------------------------------------------------------------------
#  Gemini 2.5 Flash       (ignored when DEMO_MODE=true)
# ----------------------------------------------------------------------------
GEMINI_API_KEY=                                      # [PROD]
GEMINI_MODEL=gemini-2.5-flash                        # [OPT]

# ----------------------------------------------------------------------------
#  Stripe                 (ignored when DEMO_MODE=true)
# ----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx                         # [PROD]
STRIPE_WEBHOOK_SECRET=whsec_xxx                       # [PROD]
STRIPE_PRICE_STARTER=price_xxx_starter                # [PROD]  $499/mo  · 100 docs
STRIPE_PRICE_PRO=price_xxx_pro                        # [PROD]  $1999/mo · 500 docs
STRIPE_PRICE_ENTERPRISE=price_xxx_enterprise          # [PROD]  $4999/mo · unlimited

# ----------------------------------------------------------------------------
#  Supabase Storage       (ignored when DEMO_MODE=true -> ./local_storage)
# ----------------------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co        # [PROD]
SUPABASE_SERVICE_KEY=your-service-role-key            # [PROD]
SUPABASE_STORAGE_BUCKET=documents                     # [OPT]

# ----------------------------------------------------------------------------
#  Legal / CASL footer (printed in every draft email)
# ----------------------------------------------------------------------------
COMPANY_LEGAL_NAME=Brokerage AI Inc.                                          # [OPT]
COMPANY_MAILING_ADDRESS=1000 Rue de la Gauchetiere O, Montreal, QC H3B 4W5, Canada  # [OPT]
COMPANY_UNSUBSCRIBE_URL=https://app.brokerage-ai.ca/unsubscribe               # [OPT]
